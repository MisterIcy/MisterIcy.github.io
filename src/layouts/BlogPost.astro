---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import SEOHead from '../components/SEOHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, SITE_URL } from '../consts';
import 'katex/dist/katex.min.css';

interface Props {
	post: CollectionEntry<'blog'>;
	headings?: MarkdownHeading[];
	readingTime?: number;
	words?: number;
	prevPost?: CollectionEntry<'blog'> | null;
	nextPost?: CollectionEntry<'blog'> | null;
	isHead?: boolean;
}

const {
	post,
	headings = [],
	readingTime = 1,
	words = 0,
	prevPost = null,
	nextPost = null,
	isHead = false,
} = Astro.props;

const { title, description, pubDate, updatedDate, heroImage, author, tags, category } = post.data;

const displayAuthor = author ?? {
	name: SITE_AUTHOR.name,
	bio: 'Senior Software Engineer. Engineering Manager. Mentor. Father of two.',
	social: SITE_AUTHOR.social,
};

// TOC: h2 and h3 only
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

/** Deterministic 7-char hex from post id */
function shortHash(id: string): string {
	let h = 0;
	for (let i = 0; i < id.length; i++) {
		h = (Math.imul(31, h) + id.charCodeAt(i)) | 0;
	}
	return Math.abs(h).toString(16).padStart(7, '0').slice(0, 7);
}

/** YYYY-MM-DD */
function isoDate(date: Date): string {
	return date.toISOString().slice(0, 10);
}

/** Git-style date: Sat Jun 21 2026 */
function gitDate(date: Date): string {
	return date.toLocaleDateString('en-US', {
		weekday: 'short',
		month: 'short',
		day: '2-digit',
		year: 'numeric',
	});
}

const hash = shortHash(post.id);
const pubDateIso = isoDate(pubDate);
const hasUpdated = updatedDate && updatedDate.getTime() !== pubDate.getTime();
const heroImageAlt = heroImage ? `${title} cover image` : '';
---

<html lang="en" class="dark">
	<head>
		<BaseHead title={title} description={description} image={heroImage} imageAlt={heroImageAlt} />
		<SEOHead
			title={title}
			description={description}
			image={heroImage}
			imageAlt={heroImageAlt}
			type="article"
			article={{
				publishedTime: pubDate,
				modifiedTime: updatedDate ?? pubDate,
				author: {
					name: displayAuthor.name,
					url: displayAuthor.social?.website,
				},
				section: category,
				tags: tags,
			}}
			schema={{
				type: 'BlogPosting',
				post: post,
				readingTimeMinutes: readingTime,
				breadcrumbs: [
					{ name: 'Home', url: '/' },
					{ name: 'The Field Log', url: '/blog/' },
					{ name: title, url: Astro.url.toString() },
				],
			}}
			keywords={tags}
			canonical={new URL(`/blog/${post.id}/`, SITE_URL)}
		/>
	</head>

	<body class="min-h-screen bg-bg-01 text-body antialiased">

		<!-- Skip to content -->
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:font-semibold focus:text-bg-01 focus:outline-none"
		>
			Skip to content
		</a>

		<!-- Reading progress bar — decorative, aria-hidden, z-[60] renders above sticky header -->
		<div
			aria-hidden="true"
			class="fixed left-0 top-0 z-[60] h-[2px] w-full bg-line"
			style="pointer-events:none"
		>
			<div
				id="reading-progress"
				class="h-full bg-accent"
				style="width:0%"
			></div>
		</div>

		<Header />

		<main id="main-content" class="mx-auto max-w-4xl px-5 py-10 sm:py-14 md:px-6">

			<!-- ── Breadcrumb ──────────────────────────────────────────────── -->
			<nav aria-label="Breadcrumb" class="mb-8 font-mono text-xs text-muted">
				<ol class="flex items-center gap-1.5">
					<li><a href="/" class="hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded">home</a></li>
					<li aria-hidden="true" class="text-line">/</li>
					<li><a href="/blog/" class="hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded">log</a></li>
					<li aria-hidden="true" class="text-line">/</li>
					{category && (
						<>
							<li class="text-accent">{category.toLowerCase()}</li>
							<li aria-hidden="true" class="text-line">/</li>
						</>
					)}
					<li class="text-body truncate max-w-[20ch]" aria-current="page">{post.id}</li>
				</ol>
			</nav>

			<!-- ── Post header ────────────────────────────────────────────── -->
			<header>
				<!-- Commit block -->
				<div class="overflow-x-auto rounded-xl border border-line bg-card p-4 font-mono text-xs leading-relaxed">
					<p>
						<span class="text-muted">commit</span>{' '}
						<span class="text-accent2">{hash}</span>
						{isHead && <span class="ml-2 text-accent">(HEAD → main)</span>}
					</p>
					<p>
						<span class="text-muted">Author:</span>{' '}
						<span class="text-body">{displayAuthor.name}</span>
					</p>
					<p>
						<span class="text-muted">Date:{'  '}</span>{' '}
						<time datetime={pubDateIso} class="text-body">{gitDate(pubDate)}</time>
					</p>
					{hasUpdated && (
						<p>
							<span class="text-muted">Amended:</span>{' '}
							<time datetime={isoDate(updatedDate!)} class="text-body">{gitDate(updatedDate!)}</time>
						</p>
					)}
				</div>

				<!-- Category chip -->
				{category && (
					<span class="mt-5 inline-block rounded bg-accent/15 px-2 py-0.5 font-mono text-xs text-accent">
						{category}
					</span>
				)}

				<!-- Title -->
				<h1
					class="mt-3 font-display font-extrabold leading-[0.98] tracking-tight text-ink"
					style="font-size:clamp(2rem, 5vw, 3rem)"
				>
					{title}
				</h1>

				<!-- Lead / deck -->
				{description && (
					<p
						class="mt-4 max-w-[65ch] text-body"
						style="font-size:1.5rem;line-height:1.85;letter-spacing:0.018em"
					>
						{description}
					</p>
				)}

				<!-- Reading stats -->
				<p class="mt-4 font-mono text-xs text-muted">
					{displayAuthor.name}
					{' · '}
					<span aria-label={`${readingTime} minute read`}>{readingTime} min read</span>
					{' · '}
					{words.toLocaleString()} words
				</p>

				<!-- Tags -->
				{tags && tags.length > 0 && (
					<div class="mt-4 flex flex-wrap gap-2" role="list" aria-label="Tags">
						{tags.map((tag) => (
							<span role="listitem" class="rounded border border-line px-2 py-0.5 font-mono text-xs text-body hover:border-accent hover:text-accent transition-colors">
								#{tag}
							</span>
						))}
					</div>
				)}

				<!-- Hero image -->
				{heroImage && (
					<div class="mt-8 overflow-hidden rounded-xl border border-line">
						<Image
							src={heroImage}
							alt={`${title} cover image`}
							width={1200}
							height={630}
							class="w-full h-auto object-cover"
							loading="eager"
						/>
					</div>
				)}
			</header>

			<!-- ── Reading area: prose left, refs right ──────────────────── -->
			<div class="mt-10 lg:grid lg:gap-10 xl:gap-14" style="grid-template-columns:minmax(0,1fr) 15rem">

				<!-- TOC sidebar (lg+, sticky) — explicitly placed in column 2 -->
				{tocHeadings.length > 0 && (
					<aside class="hidden lg:block lg:col-start-2 lg:row-start-1" aria-label="Table of contents">
						<div class="sticky top-24">
							<p class="font-mono text-xs uppercase tracking-widest text-muted">refs</p>
							<nav class="mt-3 border-l border-line" aria-label="Section headings">
								<ul class="space-y-0.5">
									{tocHeadings.map((h) => (
										<li>
											<a
												href={`#${h.slug}`}
												data-toc-link
												class={[
													'toc-link block -ml-px border-l-2 border-transparent py-1 text-sm text-muted',
													'hover:border-accent hover:text-accent transition-colors',
													'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-r',
													h.depth === 3 ? 'pl-5' : 'pl-3',
												].join(' ')}
											>
												{h.text}
											</a>
										</li>
									))}
								</ul>
							</nav>

							<!-- Reading progress -->
							<div class="mt-6" aria-hidden="true">
								<p class="font-mono text-xs text-muted">progress</p>
								<div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
									<div id="reading-progress-bar" class="h-full w-0 rounded-full bg-accent"></div>
								</div>
							</div>
						</div>
					</aside>
				)}

				<!-- Mobile TOC (collapsible, md and below) -->
				{tocHeadings.length > 0 && (
					<div class="mb-8 lg:hidden">
						<details class="rounded-xl border border-line bg-card">
							<summary class="flex cursor-pointer list-none items-center justify-between p-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset rounded-xl select-none">
								<span class="font-mono text-xs uppercase tracking-widest text-muted">refs</span>
								<svg class="details-chevron h-4 w-4 text-muted transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
								</svg>
							</summary>
							<nav class="px-4 pb-4 border-t border-line mt-0 pt-3" aria-label="Section headings">
								<ul class="space-y-1">
									{tocHeadings.map((h) => (
										<li>
											<a
												href={`#${h.slug}`}
												class={[
													'block rounded py-1.5 text-sm text-muted hover:text-accent transition-colors',
													'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent min-h-[44px] flex items-center',
													h.depth === 3 ? 'pl-6' : 'pl-3',
												].join(' ')}
											>
												{h.text}
											</a>
										</li>
									))}
								</ul>
							</nav>
						</details>
					</div>
				)}

				<!-- ── Prose ──────────────────────────────────────────────── -->
				<article
					id="post-article"
					class="post-prose min-w-0 lg:row-start-1"
					style={{ gridColumn: tocHeadings.length > 0 ? '1' : '1 / -1' }}
				>
					<slot />
				</article>

			</div>

			<!-- ── Author block ───────────────────────────────────────────── -->
			<section
				aria-label="About the author"
				class="mt-14 flex flex-col gap-5 rounded-2xl border border-line bg-bg-02 p-6 sm:flex-row sm:items-center md:p-7"
			>
				<!-- "A" initial tile — same system as the "B" logo mark -->
				<span
					class="grid h-14 w-14 shrink-0 place-items-center rounded-xl bg-accent font-display text-xl font-extrabold text-bg-01"
					aria-hidden="true"
				>
					A
				</span>

				<div class="flex-1 min-w-0">
					<p class="font-mono text-xs uppercase tracking-widest text-accent">Author</p>
					<h2 class="mt-1 font-display text-xl font-bold text-ink">{displayAuthor.name}</h2>
					<p class="mt-1 text-sm text-muted" style="letter-spacing:0.018em">
						{displayAuthor.bio}
					</p>
				</div>

				{displayAuthor.social?.linkedin && (
					<a
						href={displayAuthor.social.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="shrink-0 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-bg-01 hover:bg-accent2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-01"
					>
						Connect
					</a>
				)}
			</section>

			<!-- ── Post navigation ────────────────────────────────────────── -->
			{(prevPost || nextPost) && (
				<nav aria-label="Adjacent posts" class="mt-8 grid gap-3 font-mono text-sm sm:grid-cols-2">
					{prevPost ? (
						<a
							href={`/blog/${prevPost.id}/`}
							class="rounded-xl border border-line bg-card p-4 hover:border-accent/50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-01"
						>
							<span class="text-xs text-muted">← newer · {shortHash(prevPost.id)}</span>
							<p class="mt-1 font-sans font-semibold text-ink leading-snug">
								{prevPost.data.title}
							</p>
						</a>
					) : (
						<div></div>
					)}
					{nextPost && (
						<a
							href={`/blog/${nextPost.id}/`}
							class="rounded-xl border border-line bg-card p-4 hover:border-accent/50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-01 sm:text-right"
						>
							<span class="text-xs text-muted">older · {shortHash(nextPost.id)} →</span>
							<p class="mt-1 font-sans font-semibold text-ink leading-snug">
								{nextPost.data.title}
							</p>
						</a>
					)}
				</nav>
			)}

		</main>

		<Footer />

		<!-- ── Scripts ──────────────────────────────────────────────────── -->
		<script>
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			// ── Reading progress bar ──
			// Uses full-page scroll rather than the article element's bounding rect,
			// which is unreliable before the article top has scrolled past the viewport.
			const progressFill = document.getElementById('reading-progress');
			const progressBar  = document.getElementById('reading-progress-bar');

			function updateProgress() {
				const scrolled = window.scrollY;
				const total    = document.documentElement.scrollHeight - window.innerHeight;
				const pct      = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
				const value    = `${pct.toFixed(1)}%`;
				if (progressFill) progressFill.style.width = value;
				if (progressBar)  progressBar.style.width  = value;
			}

			// Always wire up the scroll listener; skip only if the user wants no motion.
			if (!prefersReducedMotion) {
				window.addEventListener('scroll', updateProgress, { passive: true });
				updateProgress(); // set initial value in case page loads mid-scroll
			}

			// ── Active TOC section via IntersectionObserver ──
			const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
			if (tocLinks.length > 0) {
				const headingEls = Array.from(
					document.querySelectorAll<HTMLElement>('#post-article h2, #post-article h3')
				);

				function setActive(slug: string | null) {
					tocLinks.forEach((link) => {
						const isActive = slug !== null && link.getAttribute('href') === `#${slug}`;
						link.classList.toggle('border-accent', isActive);
						link.classList.toggle('text-accent',   isActive);
						link.classList.toggle('border-transparent', !isActive);
						link.classList.toggle('text-muted',   !isActive);
					});
				}

				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								setActive(entry.target.id);
								return;
							}
						}
					},
					{
						rootMargin: '-80px 0px -60% 0px',
						threshold: 0,
					}
				);

				headingEls.forEach((el) => observer.observe(el));
			}

			// ── Mobile TOC: rotate chevron when open ──
			const detailsEls = document.querySelectorAll('details');
			detailsEls.forEach((details) => {
				const chevron = details.querySelector('.details-chevron');
				if (!chevron) return;
				details.addEventListener('toggle', () => {
					chevron.classList.toggle('rotate-180', details.open);
				});
			});
		</script>

		<style is:global>
			/* ── Scroll margin so sticky header never hides target ────────── */
			#post-article h2,
			#post-article h3,
			#post-article h4 {
				scroll-margin-top: 90px;
			}

			html {
				scroll-behavior: smooth;
			}
			@media (prefers-reduced-motion: reduce) {
				html { scroll-behavior: auto; }
			}
		</style>

		<style>
			/* ═══════════════════════════════════════════════════════════════
			   POST PROSE — scoped to this layout
			   All type sizes are set in rem; line-height and letter-spacing
			   follow brand guidelines (1.85 / +0.018em).
			   ═══════════════════════════════════════════════════════════════ */

			.post-prose {
				color: #cbd5e1;          /* text-body */
				font-size: 1rem;         /* 16px — right eye disengages, left reads cleanly */
				line-height: 1.85;
				letter-spacing: 0.018em;
				max-width: 65ch;
			}

			/* Paragraph spacing */
			.post-prose :global(p) {
				margin-top: 0;
				margin-bottom: 1.5em;
			}

			/* Drop cap — first paragraph only */
			.post-prose :global(> p:first-of-type::first-letter) {
				float: left;
				font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
				font-size: 4.5rem;
				font-weight: 800;
				color: #06b6d4;          /* accent */
				line-height: 0.8;
				margin-right: 0.12em;
				margin-top: 0.06em;
			}

			/* ── Headings ── */
			.post-prose :global(h2),
			.post-prose :global(h3),
			.post-prose :global(h4) {
				font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
				font-weight: 700;
				color: #f1f5f9;          /* text-ink */
				margin-top: 2.5em;
				margin-bottom: 0.75em;
				letter-spacing: -0.01em;
				line-height: 1.2;
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}

			.post-prose :global(h2) { font-size: 2.0rem; }
			.post-prose :global(h3) { font-size: 1.625rem; }
			.post-prose :global(h4) { font-size: 1.375rem; }

			/* Accent dot decoration on h2/h3 */
			.post-prose :global(h2::before),
			.post-prose :global(h3::before) {
				content: '';
				display: inline-block;
				flex-shrink: 0;
				width: 0.5rem;
				height: 0.5rem;
				border-radius: 9999px;
				background-color: #06b6d4; /* accent */
			}

			/* ── Links ── */
			.post-prose :global(a) {
				color: #06b6d4;          /* accent */
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
				transition: color 0.2s ease-out;
			}
			.post-prose :global(a:hover) {
				color: #22d3ee;          /* accent2 */
			}
			.post-prose :global(a:focus-visible) {
				outline: 2px solid #06b6d4;
				outline-offset: 2px;
				border-radius: 3px;
			}

			/* ── Strong / em ── */
			.post-prose :global(strong) { color: #f1f5f9; font-weight: 600; }
			.post-prose :global(em)     { font-style: italic; }

			/* ── Blockquote / pull quote ── */
			.post-prose :global(blockquote) {
				border-left: 2px solid #06b6d4;
				padding-left: 1.5rem;
				margin-left: 0;
				margin-right: 0;
				margin-top: 2em;
				margin-bottom: 2em;
			}
			.post-prose :global(blockquote p) {
				font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
				font-size: 1.625rem;
				font-weight: 700;
				line-height: 1.35;
				color: #f1f5f9;
				letter-spacing: -0.01em;
				margin-bottom: 0;
			}

			/* ── Inline code ── */
			.post-prose :global(:not(pre) > code) {
				font-family: 'JetBrains Mono', ui-monospace, monospace;
				font-size: 0.875em;
				color: #cbd5e1;
				background-color: #071129;
				border: 1px solid #1e293b;
				border-radius: 0.375rem;
				padding: 0.1em 0.4em;
			}
			/* Strip Tailwind prose quote marks */
			.post-prose :global(:not(pre) > code::before),
			.post-prose :global(:not(pre) > code::after) {
				content: none;
			}

			/* ── Code blocks ── */
			.post-prose :global(pre) {
				background-color: #071129; /* card */
				border: 1px solid #1e293b; /* line */
				border-radius: 0.75rem;
				padding: 1.25rem;
				overflow-x: auto;
				margin-top: 1.75em;
				margin-bottom: 1.75em;
				font-size: 0.875rem;
				line-height: 1.65;
				letter-spacing: 0;
			}
			.post-prose :global(pre code) {
				background: none;
				border: none;
				padding: 0;
				font-size: inherit;
				color: #cbd5e1;
			}

			/* ── Lists ──
			   Tailwind Preflight resets list-style:none on ul/ol, so ::marker
			   selectors have nothing to colour. We use ::before for ul bullets
			   and restore list-style:decimal for ol so ::marker can be tinted.
			   ── */

			/* Unordered list — accent dot via ::before */
			.post-prose :global(ul) {
				list-style: none;
				padding-left: 0;
				margin-bottom: 1.5em;
			}
			.post-prose :global(ul > li) {
				position: relative;
				padding-left: 1.5em;
				margin-bottom: 0.4em;
			}
			.post-prose :global(ul > li::before) {
				content: '';
				position: absolute;
				left: 0.2em;
				top: 0.7em;         /* roughly centred on the cap-height at 1.375rem/1.85 lh */
				width: 0.375rem;    /* 6px */
				height: 0.375rem;
				border-radius: 9999px;
				background-color: #06b6d4; /* accent */
			}

			/* Ordered list — restore numbering, tint the marker */
			.post-prose :global(ol) {
				list-style: decimal;
				padding-left: 1.75em;
				margin-bottom: 1.5em;
			}
			.post-prose :global(ol > li) {
				margin-bottom: 0.4em;
			}
			.post-prose :global(ol > li::marker) {
				color: #06b6d4;             /* accent */
				font-family: 'JetBrains Mono', ui-monospace, monospace;
				font-size: 0.85em;
			}

			/* Nested lists — tighter indentation, smaller dot */
			.post-prose :global(ul ul),
			.post-prose :global(ol ul) {
				margin-top: 0.4em;
				margin-bottom: 0.4em;
			}
			.post-prose :global(ul ul > li::before) {
				width: 0.25rem;
				height: 0.25rem;
				background-color: #94a3b8; /* muted — visually subordinate */
			}

			/* ── Horizontal rule ── */
			.post-prose :global(hr) {
				border: none;
				border-top: 1px solid #1e293b;
				margin: 3em 0;
			}

			/* ── Tables ── */
			.post-prose :global(table) {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.9rem;
				margin-bottom: 1.5em;
			}
			.post-prose :global(th) {
				background-color: #0f1724;
				color: #f1f5f9;
				font-family: 'JetBrains Mono', ui-monospace, monospace;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				padding: 0.6rem 1rem;
				border-bottom: 1px solid #1e293b;
				text-align: left;
			}
			.post-prose :global(td) {
				padding: 0.6rem 1rem;
				border-bottom: 1px solid #1e293b;
				color: #cbd5e1;
			}
			.post-prose :global(tbody tr:last-child td) {
				border-bottom: none;
			}

			/* ── Images ── */
			.post-prose :global(img) {
				border-radius: 0.75rem;
				border: 1px solid #1e293b;
				max-width: 100%;
				height: auto;
			}
			.post-prose :global(figure) { margin: 2em 0; }
			.post-prose :global(figcaption) {
				font-family: 'JetBrains Mono', ui-monospace, monospace;
				font-size: 0.75rem;
				color: #94a3b8;
				margin-top: 0.5em;
				text-align: center;
			}

			/* ── KaTeX overrides ── */
			.post-prose :global(.katex) { color: #cbd5e1; }

			/* ── Mermaid diagrams ── */
			.post-prose :global(.mermaid svg) {
				background: #071129;
				border: 1px solid #1e293b;
				border-radius: 0.75rem;
				padding: 1rem;
				max-width: 100%;
			}

			/* ── GitHub-flavoured alerts ── */
			.post-prose :global(.markdown-alert) {
				border-left: 2px solid #1e293b;
				padding: 0.75rem 1rem;
				border-radius: 0 0.5rem 0.5rem 0;
				margin: 1.5em 0;
				background-color: #0f1724;
			}
			.post-prose :global(.markdown-alert-note)      { border-color: #60a5fa; }
			.post-prose :global(.markdown-alert-tip)       { border-color: #4ade80; }
			.post-prose :global(.markdown-alert-important) { border-color: #a78bfa; }
			.post-prose :global(.markdown-alert-warning)   { border-color: #fde047; }
			.post-prose :global(.markdown-alert-caution)   { border-color: #f87171; }
		</style>

	</body>
</html>
