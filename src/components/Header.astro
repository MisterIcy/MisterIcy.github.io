---
import HeaderLink from './HeaderLink.astro';
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-bg-01/85 backdrop-blur-md">
	<nav
		class="mx-auto flex max-w-4xl items-center justify-between gap-4 px-5 md:px-6"
		style="height:4rem"
		aria-label="Primary"
	>
		<!-- Peer checkbox — CSS-only mobile toggle; must be first for peer-* selectors -->
		<input
			type="checkbox"
			id="mobile-nav-toggle"
			class="peer sr-only"
			aria-hidden="true"
			tabindex="-1"
		/>

		<!-- ── Logo mark + wordmark ── -->
		<a
			href="/"
			class="flex items-center gap-2.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg"
			aria-label="Binary Brew — home"
		>
			<span
				class="grid h-9 w-9 place-items-center rounded-xl bg-accent font-display text-base font-extrabold text-bg-01"
				aria-hidden="true"
			>
				B
			</span>
			<span class="font-display text-lg font-bold tracking-tight text-ink">
				Binary&nbsp;Brew
			</span>
		</a>

		<!-- ── Desktop nav ── -->
		<div class="hidden md:flex items-center gap-1">
			<HeaderLink href="/blog/">Writing</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<!-- ── Mobile hamburger ── -->
		<label
			for="mobile-nav-toggle"
			class="md:hidden cursor-pointer rounded-lg p-2 -mr-2 text-muted hover:text-ink transition-colors peer-checked:[&_.icon-menu]:hidden peer-checked:[&_.icon-close]:block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
			aria-label="Toggle navigation menu"
		>
			<svg
				class="icon-menu block"
				width="22" height="22"
				fill="none" stroke="currentColor" viewBox="0 0 24 24"
				aria-hidden="true"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
			<svg
				class="icon-close hidden"
				width="22" height="22"
				fill="none" stroke="currentColor" viewBox="0 0 24 24"
				aria-hidden="true"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</label>
	</nav>

	<!-- ── Mobile nav panel ── -->
	<div class="hidden peer-checked:block md:hidden border-t border-line bg-bg-01">
		<div class="mx-auto max-w-4xl px-5 py-3 flex flex-col gap-1">
			<HeaderLink href="/blog/" class="py-3">Writing</HeaderLink>
			<HeaderLink href="/about" class="py-3">About</HeaderLink>
		</div>
	</div>
</header>

<script is:inline>
	/* Close mobile nav when any nav link is clicked */
	(function () {
		var toggle = document.getElementById('mobile-nav-toggle');
		if (!toggle) return;
		document.querySelectorAll('a[href]').forEach(function (a) {
			if (a.closest('[aria-label="Primary"]')) {
				a.addEventListener('click', function () { toggle.checked = false; });
			}
		});
	})();
</script>
