---
import { SITE_AUTHOR, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
	<div
		class="mx-auto flex max-w-4xl flex-col items-center justify-between gap-4 px-5 py-8 font-mono text-xs text-muted sm:flex-row md:px-6"
	>
		<!-- Copyright + tagline -->
		<p>
			&copy; {year} {SITE_TITLE} &middot; Brewing stories of software, systems, and the souls behind the code.
		</p>

		<!-- Text links — no icon-only controls -->
		<nav aria-label="Footer" class="flex items-center gap-4">
			<a
				href="/rss.xml"
				class="hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
			>
				RSS
			</a>

			{SITE_AUTHOR.social.github && (
				<a
					href={`https://github.com/${SITE_AUTHOR.social.github}`}
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
				>
					GitHub
				</a>
			)}

			{SITE_AUTHOR.social.linkedin && (
				<a
					href={SITE_AUTHOR.social.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
				>
					LinkedIn
				</a>
			)}
		</nav>
	</div>
</footer>
