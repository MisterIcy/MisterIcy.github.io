---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getReadingStats } from '../../lib/readingTime';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const isDev = import.meta.env.DEV;
	const sortedPosts = allPosts
		.filter((p) => isDev || !p.data.draft)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

	return sortedPosts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			// prevPost = the newer post (lower index); nextPost = the older post
			prevPost: sortedPosts[index - 1] ?? null,
			nextPost: sortedPosts[index + 1] ?? null,
			isHead: index === 0,
		},
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	prevPost: CollectionEntry<'blog'> | null;
	nextPost: CollectionEntry<'blog'> | null;
	isHead: boolean;
}

const { post, prevPost, nextPost, isHead } = Astro.props;
const { Content, headings } = await render(post);
const { minutes: readingTime, words } = getReadingStats(post.body ?? '');
---

<BlogPost
	post={post}
	headings={headings}
	readingTime={readingTime}
	words={words}
	prevPost={prevPost}
	nextPost={nextPost}
	isHead={isHead}
>
	<Content />
</BlogPost>
